# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://formscapeglobal.com

# Year printed in the prerendered footer before the browser updates it.
NEXT_PUBLIC_BUILD_YEAR=2026

# ---- Enquiry delivery: configure ONE of the options below -----------------
# Option A — any webhook that accepts multipart/form-data (Zapier, Make, n8n,
# Google Apps Script, a CRM...). Receives all fields plus the attachment.
ENQUIRY_WEBHOOK_URL=

# Option B — email via Resend (https://resend.com). The sender domain must be verified.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=nayan@formscapeglobal.com
ENQUIRY_FROM_EMAIL=Formscape Global Website <website@formscapeglobal.com>
